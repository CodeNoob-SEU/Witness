# Never commit a real key. Third-party compatible endpoints receive your prompts
# and tool outputs, so only use endpoints you trust.
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# responses (recommended for OpenAI) or chat_completions (widest compatibility)
OPENAI_API_MODE=responses
