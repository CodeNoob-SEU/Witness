# Safe template only. Never commit a real API key, database password, or DSN.
# This project does not load .env automatically; inject secrets with your shell,
# deployment platform, or secret manager.

# OpenAI or a trusted OpenAI-compatible endpoint. A third-party endpoint receives
# prompts, tool schemas, and tool results.
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
# responses (recommended for OpenAI) or chat_completions (widest compatibility)
OPENAI_API_MODE=responses
# Set true only for endpoints that reject optional OpenAI protocol fields.
OPENAI_COMPAT_MODE=false
# Keep false. Enable only for a trusted private network that cannot provide HTTPS.
OPENAI_ALLOW_INSECURE_HTTP=false

# Production durable journal. REACT_AGENT_POSTGRES_DSN takes precedence; when it
# is unset, DATABASE_URL is accepted as a compatibility fallback. Leave both
# unset for process-local InMemoryRunJournal (all Run state is lost on restart).
# REACT_AGENT_POSTGRES_DSN=postgresql://user:password@127.0.0.1:5432/react_agent
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/react_agent

# Optional isolated Git workspace. Set both or neither. The managed root must be
# outside the repository, must not be a symlink, and must not contain the repo.
# REACT_AGENT_REPOSITORY=/absolute/path/to/repository
# REACT_AGENT_WORKTREE_ROOT=/absolute/separate/path/to/managed-worktrees
# Require approval for the built-in run_command tool (only with a managed workspace).
# REACT_AGENT_COMMAND_APPROVAL=false
# Gitignored inputs a fresh worktree lacks (comma-separated, repository-relative)
# and a one-off command to run in each new worktree.
# REACT_AGENT_WORKSPACE_SEED_PATHS=src/_pytest/_version.py
# REACT_AGENT_WORKSPACE_SEED_COMMAND=pip install -e . --no-deps
# Resume non-terminal runs whose writer lease expired (crashed worker, transient
# model outage) from inside the web process. GET /api/supervisor shows the last sweep.
# REACT_AGENT_SUPERVISOR=false
# REACT_AGENT_SUPERVISOR_INTERVAL_S=5

# Context governance. A production Runtime should use a private persistent
# summary directory so completed content-addressed summaries survive restart.
REACT_AGENT_CONTEXT_STRATEGY=tiered
# REACT_AGENT_CONTEXT_SUMMARY_DIR=/absolute/private/path/to/context-summaries

# Same-origin web workbench.
REACT_AGENT_WEB_HOST=127.0.0.1
REACT_AGENT_WEB_PORT=8000

# OpenTelemetry exporter settings. They take effect only when an SDK/provider is
# initialized (for example through opentelemetry-instrument).
OTEL_SERVICE_NAME=react-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# Exact, comma-separated metric labels. When unset, the Web Runtime freezes the
# configured OPENAI_MODEL and its registered tool names as the bounded defaults.
# Wildcards are rejected. These explicit values match the local acceptance run.
REACT_AGENT_OTEL_METRIC_ALLOWED_MODELS=gpt-5.6-terra
REACT_AGENT_OTEL_METRIC_ALLOWED_TOOLS=calculate_expression
